#!/usr/bin/env python3
"""Toggle tiling; fit and center newly floating windows on their own monitor."""
import argparse,fcntl,json,math,os,subprocess
from pathlib import Path

def query(name):
    return json.loads(subprocess.check_output(['hyprctl',name,'-j'],text=True))

def dispatch(name,arg):
    result=subprocess.run(['hyprctl','dispatch',name,arg],capture_output=True,text=True,check=True)
    if result.stdout.strip()!='ok':raise RuntimeError(result.stdout.strip() or result.stderr.strip())

def usable_area(monitor):
    w,h=monitor['width'],monitor['height']
    if monitor.get('transform',0)%2:w,h=h,w
    scale=monitor.get('scale',1) or 1
    w,h=w/scale,h/scale
    left,top,right,bottom=monitor.get('reserved',[0,0,0,0])
    return monitor['x']+left,monitor['y']+top,w-left-right,h-top-bottom

def fit(size,area):
    x,y,aw,ah=area;w,h=size
    ratio=min(1.,aw*.8/max(1,w),ah*.8/max(1,h))
    w,h=max(1,math.floor(w*ratio)),max(1,math.floor(h*ratio))
    return w,h,round(x+(aw-w)/2),round(y+(ah-h)/2)

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--address',help='Target a specific window instead of the focused window')
    parser.add_argument('--dry-run',action='store_true')
    args=parser.parse_args()
    runtime=Path(os.environ.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))
    with (runtime/'yorha-toggle-float.lock').open('w') as lock:
        # A second simultaneous keypress must not race the first toggle.
        try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:return
        window=next((w for w in query('clients') if w['address']==args.address),{}) if args.address else query('activewindow')
        if not window.get('address') or not window.get('mapped',True):return
        address='address:'+window['address']
        if window.get('fullscreen'):
            # Leave an explicitly fullscreen window alone; its fullscreen shortcut remains available.
            return
        if window.get('floating'):
            if args.dry_run:print(json.dumps({'action':'settiled','address':window['address']}))
            else:dispatch('settiled',address)
            return
        monitor=next((m for m in query('monitors') if m['id']==window['monitor']),None)
        if not monitor:return
        area=usable_area(monitor);width,height,x,y=fit(window['size'],area)
        if args.dry_run:
            print(json.dumps({'action':'float','address':window['address'],'usable_area':area,'size':[width,height],'at':[x,y]}));return
        dispatch('setfloating',address)
        dispatch('resizewindowpixel',f'exact {width} {height},{address}')
        # Honor application size constraints when calculating the final center.
        current=next((w for w in query('clients') if w['address']==window['address']),None)
        if not current or not current['floating']:return
        ax,ay,aw,ah=area;width,height=current['size']
        dispatch('movewindowpixel',f'exact {round(ax+(aw-width)/2)} {round(ay+(ah-height)/2)},{address}')

if __name__=='__main__':main()
