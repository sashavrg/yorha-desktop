#!/usr/bin/env python3
"""Best-effort NVIDIA / AMD GPU busy percent; never invent a measurement."""
from pathlib import Path
import shutil
import subprocess
if shutil.which('nvidia-smi'):
    try:
        result = subprocess.run(['nvidia-smi','--query-gpu=utilization.gpu','--format=csv,noheader,nounits'],capture_output=True,text=True,timeout=2)
        if result.returncode == 0:
            print(result.stdout.splitlines()[0].strip());raise SystemExit(0)
    except (OSError,subprocess.TimeoutExpired,IndexError): pass
for path in sorted(Path('/sys/class/drm').glob('card[0-9]*/device/gpu_busy_percent')):
    try: print(int(path.read_text().strip()));raise SystemExit(0)
    except (OSError,ValueError): pass
print('N/A')
