#!/usr/bin/env python3
"""Show a themed notice or require explicit confirmation; closing always cancels."""
import argparse
from pathlib import Path
import shutil
import subprocess
import sys


def find_command(name):
    local = Path.home() / '.local/bin' / name
    return str(local) if local.is_file() and local.stat().st_mode & 0o111 else shutil.which(name)


def show(kind, title, text, accept='EXECUTE'):
    buttons = ['CANCEL', accept] if kind == 'confirm' else ['ACKNOWLEDGE']
    native = find_command('hyprland-dialog')
    if native:
        command = [native, '--apptitle', 'YoRHa : SYSTEM CONTROL', '--title', title,
                   '--text', text, '--buttons', ';'.join(buttons)]
    else:
        rofi = find_command('rofi')
        if not rofi:
            print('yorha-dialog: install hyprland-guiutils or Rofi to show dialogs', file=sys.stderr)
            return False
        command = [rofi, '-dmenu', '-i', '-p', title, '-mesg', text,
                   '-theme-str', 'listview { lines: 2; }']
    try:
        result = subprocess.run(command, input='' if native else '\n'.join(buttons)+'\n',
                                capture_output=True, text=True)
    except OSError as exc:
        print(f'yorha-dialog: {exc}', file=sys.stderr)
        return False
    # Native window close returns success but no selected label. Neither an
    # empty result, an error, nor arbitrary typed Rofi text may approve an action.
    selected = result.stdout.strip()
    return result.returncode == 0 and selected == (accept if kind == 'confirm' else 'ACKNOWLEDGE')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('kind', choices=['confirm', 'message'], nargs='?', default='message')
    parser.add_argument('--title', default='SYSTEM / OPERATOR NOTICE')
    parser.add_argument('--text', required=True)
    parser.add_argument('--accept', default='EXECUTE')
    args = parser.parse_args()
    if not args.accept or any(c in args.accept for c in ';\n\r') or args.accept == 'CANCEL':
        parser.error('accept must be a single non-cancel button label')
    return 0 if show(args.kind, args.title, args.text, args.accept) else 1


if __name__ == '__main__':
    raise SystemExit(main())
