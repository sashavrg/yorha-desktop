#!/usr/bin/env python3
"""Read-only dependency, asset and live Hyprland diagnostics."""
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

root=Path.home()/'.local/share/yorha'
failed=[]
def report(ok,message):
    print(('  OK  ' if ok else '  !!  ')+message)
    if not ok: failed.append(message)

print('■ YoRHa / SYSTEM DIAGNOSTICS')
for command in ['hyprctl','waybar','rofi','swww','kitty','swaync','cava','pactl','playerctl','hyprlock']:
    report(bool(shutil.which(command)),command)
for module in ['gi','cairo','numpy']:
    report(importlib.util.find_spec(module) is not None,'Python '+module)
probe="import gi;gi.require_version('Gtk','3.0');gi.require_version('GtkLayerShell','0.1');gi.require_version('Rsvg','2.0');from gi.repository import Gtk,GtkLayerShell,Rsvg"
result=subprocess.run([sys.executable,'-c',probe],capture_output=True)
report(result.returncode==0,'GTK 3 / layer shell / Rsvg introspection')
if root.exists():
    for mode in ['day','night']:
        image=root/'wallpapers/interface'/('night' if mode=='night' else '')/'yorha-2560x1440.png'
        report(image.is_file(),mode+' wallpaper')
    if (Path.home()/'.config/yorha/yorha-cockpit-widget-enabled').exists():
        python=root/'calendar-venv/bin/python'
        result=subprocess.run([str(python),'-c','import gi,icalendar,recurring_ical_events,psutil'],capture_output=True) if python.exists() else None
        report(result is not None and result.returncode==0,'Calendar runtime')
    if os.environ.get('HYPRLAND_INSTANCE_SIGNATURE') and shutil.which('hyprctl'):
        result=subprocess.run(['hyprctl','configerrors'],capture_output=True,text=True)
        output=result.stdout.strip()
        report(result.returncode==0 and (not output or output=='ok'),'Hyprland config errors')
        if output and output!='ok': print(output)
    else: print('  --  No live Hyprland session; runtime checks skipped')
else: print('  --  Theme not installed in this home')
print('\nPrivate calendar URLs and task contents are never displayed by this command.')
sys.exit(1 if failed else 0)
